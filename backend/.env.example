# PostgreSQL, hosted on Neon (free tier, no expiration, encrypted at rest).
# DATABASE_URL uses Neon's pooled connection (PgBouncer) for normal app queries.
# DIRECT_URL uses the unpooled connection — required by `prisma migrate` because
# schema-change statements aren't compatible with connection pooling.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

PORT=4000
FRONTEND_URL="http://localhost:5173"

# Required. Signs login session tokens — treat this like a password.
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value"

# Optional. Only needed once, to bootstrap a brand-new empty database (creates
# the default family members + categories) on a host with no shell access,
# via: POST /api/admin/bootstrap with header x-bootstrap-secret: <this value>.
# The endpoint refuses to run a second time once any user exists, so you can
# safely leave this set — but rotating/removing it afterward is good hygiene.
BOOTSTRAP_SECRET="replace-with-a-long-random-value"
