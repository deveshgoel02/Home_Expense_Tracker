# SQLite is used by default for zero-config local development.
# To use PostgreSQL instead, change the "provider" in prisma/schema.prisma
# from "sqlite" to "postgresql" and set DATABASE_URL to a postgres connection string,
# e.g. postgresql://user:password@localhost:5432/family_expenses
DATABASE_URL="file:./dev.db"

PORT=4000
FRONTEND_URL="http://localhost:5173"
